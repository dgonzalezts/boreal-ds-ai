<mxfile host="app.diagrams.net"><diagram name="Boreal release flow" id="Boreal release flow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Current manual release flow (maintainer machine, macOS/Linux)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="pr" value="PR (Conventional Commit title)&lt;br&gt;squash-merge into release/current" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="230" height="80" as="geometry"/></mxCell><mxCell id="pre" value="Maintainer: fnm use, pnpm install --frozen-lockfile,&lt;br&gt;npm whoami, on release/current, clean tree" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="260" height="80" as="geometry"/></mxCell><mxCell id="r1" value="release-it: @pxglobal/boreal-style-guidelines&lt;br&gt;(pnpm release:all, workspace-concurrency=1)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="260" height="80" as="geometry"/></mxCell><mxCell id="r2" value="release-it: @pxglobal/boreal-web-components&lt;br&gt;before:init build + check:cem" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="230" width="260" height="80" as="geometry"/></mxCell><mxCell id="r3" value="release-it: @pxglobal/boreal-react&lt;br&gt;prerelease: validate:pack:react" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="230" width="260" height="80" as="geometry"/></mxCell><mxCell id="r4" value="release-it: @pxglobal/boreal-vue&lt;br&gt;prerelease: validate:pack:vue" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="230" width="260" height="80" as="geometry"/></mxCell><mxCell id="pub" value="npm publish (pnpm publish)&lt;br&gt;public @pxglobal; may need browser approval" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="700" y="380" width="260" height="80" as="geometry"/></mxCell><mxCell id="tag" value="Commit + tag @pxglobal/pkg@version&lt;br&gt;push --follow-tags to origin" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1040" y="380" width="260" height="80" as="geometry"/></mxCell><mxCell id="doc" value="pnpm deploy:docs&lt;br&gt;Storybook build + Chromatic" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1040" y="520" width="260" height="70" as="geometry"/></mxCell><mxCell id="e3" value="merged" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pr" target="pre"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="pnpm release:all" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pre" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="1 -&gt; 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="2 -&gt; 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="3 -&gt; 4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="after bump (each package)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r3" target="pub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pub" target="tag"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="after all packages released" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tag" target="doc"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>